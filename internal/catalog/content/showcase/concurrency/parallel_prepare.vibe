# title: Parallel preparation
# category: Vibescript Showcase
# difficulty: Showcase
# summary: Run independent functions in one Tasks.run block and combine their results.
# description: tasks.spawn starts a function and returns a handle. Reading handle.value waits for the result. The block waits for every task before it exits.
# tags: concurrency, tasks, structured-concurrency, spawn
# vibe: 0.4

def prepare_user(user)
  {
    id: user[:id],
    greeting: "ready:" + user[:id]
  }
end

def prepare_team(lead, second, third)
  Tasks.run(max: 3) do |tasks|
    a = tasks.spawn(:prepare_user, lead)
    b = tasks.spawn(:prepare_user, second)
    c = tasks.spawn(:prepare_user, third)

    first = a.value
    second_ready = b.value
    third_ready = c.value
    return [first, second_ready, third_ready]
  end
end

def run
  prepared = prepare_team(
    { id: "alice" },
    { id: "bob" },
    { id: "carol" }
  )

  {
    prepared: prepared,
    count: prepared.length
  }
end
