# title: Late fee
# category: Finance
# difficulty: Showcase
# summary: Tiered late fees with duration and money primitives — the homepage hero example.
# tags: money, durations

def late_fee(overdue: duration) -> money
  if overdue <= 3.days
    money("0.00 USD")
  elsif overdue <= 14.days
    money("5.00 USD")
  else
    money("15.00 USD")
  end
end

def run
  {
    on_time: late_fee(2.days),
    grace: late_fee(10.days),
    overdue: late_fee(3.weeks)
  }
end
